NODE_ENV=development
HOST=127.0.0.1
PORT=5001
MCP_RESOURCE_URL=http://localhost:5001/mcp
KEYCLOAK_AUTHORITY=http://localhost:8080/realms/maletapp
# Host execution: leave empty. Compose uses http://keycloak:8080.
KEYCLOAK_INTERNAL_ORIGIN=
GATEWAY_URL=http://localhost:5000
GATEWAY_AUDIENCE=api://maletapp
EXCHANGE_CLIENT_ID=maletapp-mcp
# Store the confidential client secret only in ignored .env, never in clients.
EXCHANGE_CLIENT_SECRET=
# This is the Keycloak target CLIENT ID, not its custom audience mapper value.
EXCHANGE_AUDIENCE=maletapp-api
HTTP_TIMEOUT_MS=10000
# Explicit browser origins; empty denies browser cross-origin access.
ALLOWED_ORIGINS=
# Extra HTTP Host values if needed, e.g. 127.0.0.1:5001.
ALLOWED_HOSTS=
# Public pre-registered PKCE client for npm run login (manual setup).
MCP_LOGIN_CLIENT_ID=maletapp-mcp-cli
