{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "erasableSyntaxOnly": true, "skipLibCheck": true, "rewriteRelativeImportExtensions": true,
    "outDir": "dist", "rootDir": "src", "noUncheckedIndexedAccess": true
  },
  "include": ["src/**/*.ts"]
}
