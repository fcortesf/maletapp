NODE_ENV=development
PORT=5000
KEYCLOAK_AUTHORITY=http://localhost:8080/realms/maletapp
# Host execution needs no internal override. Compose sets http://keycloak:8080.
# KEYCLOAK_INTERNAL_ORIGIN=
KEYCLOAK_AUDIENCE=api://maletapp
# Used for running the gateway outside Docker; Compose overrides this.
DOMAIN_API_URL=http://localhost:5110
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-local-password

# Set by the authorized local MCP provisioning script; empty keeps default features.
KEYCLOAK_FEATURES=
# MCP confidential client credentials are provisioned into ignored .env only.
EXCHANGE_CLIENT_ID=maletapp-mcp
EXCHANGE_AUDIENCE=maletapp-api
EXCHANGE_CLIENT_SECRET=
