@Trip.API_HostAddress = http://localhost:5110
@TestUserId = 11111111-1111-1111-1111-111111111111
@TripId = 22222222-2222-2222-2222-222222222222
@ItemId = 33333333-3333-3333-3333-333333333333

### Development-only note
# `X-Test-User-Id` is only for local/manual testing before a production auth edge exists.
# The target architecture treats this API as a private-by-default core service.

### Create trip
POST {{Trip.API_HostAddress}}/trips
Accept: application/json
Content-Type: application/json
X-Test-User-Id: {{TestUserId}}

{
  "destination": "Vienna",
  "startDate": "2026-06-01",
  "endDate": "2026-06-04"
}

### Delete trip
DELETE {{Trip.API_HostAddress}}/trips/{{TripId}}
Accept: application/json
X-Test-User-Id: {{TestUserId}}

### List items by trip
GET {{Trip.API_HostAddress}}/trips/{{TripId}}/items
Accept: application/json
X-Test-User-Id: {{TestUserId}}

### Create item in trip
POST {{Trip.API_HostAddress}}/trips/{{TripId}}/items
Accept: application/json
Content-Type: application/json
X-Test-User-Id: {{TestUserId}}

{
  "name": "Passport",
  "defaultItemId": null,
  "notes": "Keep in hand luggage",
  "itemCount": 2
}

### Get item
GET {{Trip.API_HostAddress}}/items/{{ItemId}}
Accept: application/json
X-Test-User-Id: {{TestUserId}}

### Patch item notes and quantity
PATCH {{Trip.API_HostAddress}}/items/{{ItemId}}
Accept: application/json
Content-Type: application/json
X-Test-User-Id: {{TestUserId}}

{
  "notes": "Keep in hand luggage",
  "itemCount": 2
}

### Delete item
DELETE {{Trip.API_HostAddress}}/items/{{ItemId}}
X-Test-User-Id: {{TestUserId}}
