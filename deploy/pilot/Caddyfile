{$AUTH_HOST} {
    @public path /realms/maletapp/* /resources/*
    handle @public {
        reverse_proxy keycloak:8080
    }
    handle {
        respond 404
    }
}
{$API_HOST} {
    handle /web/* {
        reverse_proxy gateway:3000
    }
    handle {
        respond 404
    }
}
{$MCP_HOST} {
    @mcp path /mcp /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/mcp
    handle @mcp {
        reverse_proxy mcp:5001
    }
    handle {
        respond 404
    }
}
