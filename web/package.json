{
  "name": "maletapp-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "generate:types": "node scripts/contracts.mjs",
    "check:contracts": "node scripts/contracts.mjs --check",
    "preview": "vite preview --host 127.0.0.1",
    "e2e:static": "npm run build && E2E_STATIC=1 playwright test",
    "setup:keycloak": "node scripts/setup-keycloak.mjs",
    "setup:e2e": "node scripts/e2e-users.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "@tanstack/react-query": "5.104.0",
    "keycloak-js": "25.0.6",
    "i18next": "26.4.2",
    "react-i18next": "17.0.15",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24"
  },
  "devDependencies": {
    "vite": "8.3.1",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "openapi-typescript": "7.13.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "24.13.3",
    "vitest": "5.0.2",
    "jsdom": "26.1.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/user-event": "14.6.7",
    "@playwright/test": "1.63.0",
    "@axe-core/playwright": "4.13.0"
  }
}
